# Copier ce fichier en .env et renseigner les clés. Ne jamais committer .env.

# Clé API Anthropic (https://console.anthropic.com/settings/keys)
ANTHROPIC_API_KEY=

# Clé API Deepgram (https://console.deepgram.com → API Keys)
DEEPGRAM_API_KEY=

# Chemin du fichier OAuth client téléchargé depuis Google Cloud Console (type « Application de bureau »)
YOUTUBE_CLIENT_SECRETS=client_secret.json
